# Normalize line endings in the repository; check out with the platform default.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.xls binary
*.xlsx binary
*.xlsm binary
