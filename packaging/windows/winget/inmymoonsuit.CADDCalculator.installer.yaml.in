# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json
# Template: packaging/windows/winget.py render fills the placeholders (distribution slice d3).
PackageIdentifier: inmymoonsuit.CADDCalculator
PackageVersion: {{VERSION}}
InstallerType: inno
Scope: user
InstallModes:
  - interactive
  - silent
  - silentWithProgress
UpgradeBehavior: install
Installers:
  - Architecture: x64
    InstallerUrl: {{INSTALLER_URL}}
    InstallerSha256: {{INSTALLER_SHA256}}
ManifestType: installer
ManifestVersion: 1.10.0
